marimo/_static/
marimo/_lsp/
__marimo__/

# ============================================================================
# PROJECT-SPECIFIC PATTERNS: WECA Indicators
# ============================================================================

# Claude Code session state
.claude/

# Data files (keep example data whitelisted)
*.csv
*.xlsx
*.xls

data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/examples/*.csv
!data/examples/*.xlsx
!data/common_project_data/*.xlsx
!data/common_project_data/*.csv
!data/common_project_data/*.rds
# FACT table: per-indicator observation CSVs are committed
!data/fact/
!data/fact/*.csv
!data/fact/.gitkeep


# Quarto outputs
_output/
# Chart PNGs copied from _freeze/ when the presentation renders
presentation/figures/
# NOTE: _freeze/ must be tracked in git for collaborative rendering
# Each analyst's cached outputs allow others to render without their data
*.html
*.pdf
*_files/
!chapters/**/index_files/figure-html/
!chapters/**/index_files/figure-html/*.png
*_cache/
/.quarto/

