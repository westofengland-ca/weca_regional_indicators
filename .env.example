# Environment variables for the WECA regional indicators project.
#
# Copy this file to `.env` (git-ignored) and fill in real values. `.env` is
# loaded with readRenviron(".env") in the scripts that need it.

# --- Azure Blob source data (scripts/R/azure_blob.R) ------------------------
# Entra ID (OAuth) authentication - none of these values are secret; they are
# public identifiers. Obtain AZURE_TENANT_ID and AZURE_CLIENT_ID from the data
# engineer (see WIP/azure-migrate/data-engineer-spec.md). You authenticate as
# yourself via device-code flow + MFA; there is no shared token to store here.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
STORAGE_ACCOUNT_URL=https://wecasadwcorpdev.blob.core.windows.net
CONTAINER=analysis-landingzone
